# Local auth/session
REUP_SESSION_SECRET=replace-with-a-long-random-secret
REUP_ADMIN_USERNAME=admin
# Required only when bootstrapping the first local admin. Use a unique password.
REUP_ADMIN_PASSWORD=replace-with-a-unique-local-admin-password
REUP_ADMIN_EMAIL=admin@example.com

# Add exact deployed frontend origins here when using a public website.
REUP_ENGINE_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:8000,http://127.0.0.1:8000

# Local Engine resource limits. The process endpoint refuses new render jobs
# below this free-space threshold instead of failing halfway through FFmpeg.
REUP_MIN_FREE_DISK_BYTES=2147483648
REUP_MAX_PARALLEL_DOWNLOADS=1
REUP_MAX_PARALLEL_PIPELINES=1
REUP_YTDLP_CONCURRENT_FRAGMENTS=2
# Optional: chrome, msedge, or bundled. Default tries Chrome, Edge, then bundled Chromium.
REUP_BROWSER_CHANNEL=auto

# SMTP is optional while developing locally. Without it, the verification
# code is printed in the terminal running Reup AI.
REUP_SMTP_HOST=smtp.gmail.com
REUP_SMTP_PORT=587
REUP_SMTP_USER=your-address@example.com
REUP_SMTP_PASSWORD=your-app-password
REUP_SMTP_FROM=your-address@example.com
