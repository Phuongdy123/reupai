NEXT_PUBLIC_LOCAL_ENGINE_URL=http://127.0.0.1:17888
# Set false only when rolling back unified login; requires Engine 0.2.23 or newer.
NEXT_PUBLIC_GOOGLE_GEMINI_LOGIN=true
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Server-only variables: set in Vercel, never commit or prefix with NEXT_PUBLIC_.
# Prefer the current sb_secret_ key. SUPABASE_SERVICE_ROLE_KEY remains supported
# temporarily for projects that have not migrated from legacy keys.
SUPABASE_SECRET_KEY=YOUR_SB_SECRET_KEY

# Only set true after applying the billing migration, setting all payOS keys,
# registering the webhook, and distributing Engine 0.2.26 or newer.
BILLING_ENABLED=false
BILLING_SITE_URL=https://www.reupai.cloud
PAYOS_CLIENT_ID=YOUR_PAYOS_CLIENT_ID
PAYOS_API_KEY=YOUR_PAYOS_API_KEY
PAYOS_CHECKSUM_KEY=YOUR_PAYOS_CHECKSUM_KEY
